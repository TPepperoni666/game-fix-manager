__pycache__/
*.pyc
.gfm-orig
*.part

# Remote payloads: too big for git, shipped as release assets (see manifest
# remote_payloads). Present locally after capture/first fetch.
store/games/watch-dogs/payload/mod/data_win64/patch.dat

# Local capture working files (TCU binaries + personal save state) — the
# publishable payload gets promoted out of here deliberately, not by default.
store/games/the-crew/capture/pre-update-tcu-files/
store/games/the-crew/capture/post-update-tcu-files/

# Downloaded/extracted at apply time — never committed (some contain
# copyrighted game executables that must stay out of the public repo).
#
# Matched by extract_to NAME, not per recipe. The old per-recipe list had
# already missed two of them — git check-ignore showed
# gta-iv/payload/fusionfix/FusionFix.asi and
# heroes-of-the-pacific/payload/asiloader/dinput8.dll as NOT ignored, so
# `git add -A` after an apply would have committed them. A pattern cannot be
# out of date the next time a recipe reuses one of these names.
store/games/*/payload/downloads/
store/games/*/payload/fix/
store/games/*/payload/fusionfix/
store/games/*/payload/asiloader/
store/games/*/payload/dxvk/
store/games/*/payload/patch/
# Transient: an interrupted extraction unpacks here and is cleaned up on the
# next apply, but it must never be committable in the meantime.
store/games/*/payload/*.gfm-extracting/

# Eclipse perf mods — modified copyrighted game exes, local-payloads only,
# never committed. Recipes are manifest-only; files live off git.
store/games/eclipse-*/payload/

# PyInstaller build artifacts
dist/
build/
*.spec
