[Unit]
Description=KDE Secret Service (headless) for Game Mode - lets Xodus read the Forza sign-in
Documentation=file:///home/deck/forza-v02-backup-20261015/README-gamemode-wallet.txt
# Game Mode's user manager has no DISPLAY, so D-Bus activation of ksecretd crashes there.
# Runs only with the gamescope session and stops with it; Desktop Mode is untouched.
PartOf=gamescope-session.target

[Service]
Type=dbus
BusName=org.freedesktop.secrets
Environment=QT_QPA_PLATFORM=offscreen
ExecStart=/usr/bin/ksecretd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=gamescope-session.target
